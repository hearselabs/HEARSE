# ═══════════════════════════════════════════════════════════
#  HEARSE — pengaturan
#
#  CARA PAKAI: salin file ini jadi ".env" lalu isi nilainya.
#  Di Terminal:   cp .env.example .env
#
#  File .env JANGAN pernah di-upload ke GitHub atau dibagikan.
# ═══════════════════════════════════════════════════════════


# ── 1. GROQ (penulis obituarinya) ──────────────────────────
# Gratis. Daftar di https://console.groq.com → API Keys → Create
# Kalau dikosongkan, HEARSE tetap jalan pakai penulis cadangan
# (hasilnya kaku, tapi sistemnya tetap bisa kamu lihat bekerja).

GROQ_API_KEY=

# Nama model. Kalau muncul error 404/400, jalankan:  npm run models
# lalu salin salah satu nama dari daftar yang muncul ke sini.
GROQ_MODEL=llama-3.3-70b-versatile


# ── 2. TELEGRAM (gratis, tanpa batas) ──────────────────────
# a) Buka @BotFather di Telegram → /newbot → salin token-nya ke bawah
TELEGRAM_BOT_TOKEN=

# b) Buat channel publik, jadikan bot-mu admin, lalu tulis @namachannel
TELEGRAM_CHANNEL_ID=@hearseobituaries

# c) Chat pribadimu — ke sini bot mengirim draft harian untuk kamu
#    salin ke X. Cara dapat angkanya: chat @userinfobot di Telegram.
TELEGRAM_OWNER_ID=


# ── 3. AMBANG KEMATIAN (boleh dibiarkan) ───────────────────
# Token dianggap mati kalau likuiditasnya di bawah ini (dolar)
DEAD_LIQUIDITY_USD=500

# ...atau volume 24 jamnya di bawah ini DAN tidak ada pembeli sama sekali
DEAD_VOLUME_24H_USD=150

# Umur minimum sebelum boleh dinyatakan mati (menit).
# Jangan terlalu kecil — nanti bayi baru lahir ikut dikubur.
MIN_AGE_MINUTES=60

# Maksimal obituari per sekali jalan. 4x sehari x 4 = 16 obituari/hari.
MAX_BURIALS_PER_RUN=4

# Kolam likuiditas di atas angka ini tapi tanpa transaksi = palsu, diabaikan
FAKE_LIQUIDITY_USD=5000000
